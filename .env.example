# ---- Database ---------------------------------------------------------------
# Owner connection: used ONLY by `python -m db.load_data` (creates tables, loads data, creates the read-only role)
DATABASE_URL_ADMIN=postgresql+psycopg2://postgres:postgres@localhost:5432/ipl
# Password you choose for the least-privilege role the app uses
READONLY_PASSWORD=change-me
# What the API / UI / eval use (SELECT-only role, created by the loader)
DATABASE_URL_RO=postgresql+psycopg2://ipl_readonly:change-me@localhost:5432/ipl
STATEMENT_TIMEOUT_MS=5000
MAX_ROWS=500

# ---- LLM (any OpenAI-compatible provider) -----------------------------------
# groq | gemini | ollama | openai
LLM_PROVIDER=groq
# A model your provider currently offers (check its model list; free-tier models change).
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional overrides
# LLM_API_KEY=
# LLM_BASE_URL=
LLM_CACHE=1          # cache LLM replies on disk: reproducible evals, saves free-tier quota

# ---- Pipeline / limits -------------------------------------------------------
SQL_MAX_RETRIES=2
RATE_LIMIT_PER_MIN=8
DAILY_ASK_CAP=500

# ---- UI ---------------------------------------------------------------------
API_URL=http://localhost:8000
